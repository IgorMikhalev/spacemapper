// Windows resources: program icon and file version information.
// Compiled to spacemapper.res with: llvm-rc /fo spacemapper.res spacemapper.rc
// (or rc.exe from the Windows SDK). build.rs links the .res file.
1 ICON "../../assets/icon/spacemapper.ico"

1 VERSIONINFO
FILEVERSION 0,6,0,0
PRODUCTVERSION 0,6,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Martin Fleisch"
      VALUE "FileDescription", "Spacemapper"
      VALUE "FileVersion", "0.6.0"
      VALUE "InternalName", "spacemapper"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "Spacemapper.exe"
      VALUE "ProductName", "Spacemapper"
      VALUE "ProductVersion", "0.6.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
