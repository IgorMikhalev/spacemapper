# Maintainer: Martin Fleisch
#
# Builds the package from this repository checkout:
#   cd packaging/arch && makepkg -si
pkgname=spacemapper
pkgver=0.6.1
pkgrel=1
pkgdesc="Treemap disk usage viewer"
arch=('x86_64')
url="https://github.com/Martin-ii/spacemapper"
license=('GPL-3.0-or-later')
depends=('glibc' 'libglvnd' 'libxkbcommon' 'wayland' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=(
  'polkit: full access scans'
  'xdg-utils: open files and folders'
  'libxkbcommon-x11: X11 support'
  'libxcursor: X11 support'
  'libxi: X11 support'
)
options=('!lto' '!debug')

_root="$startdir/../.."

build() {
  cd "$_root"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked
}

package() {
  cd "$_root"
  install -Dm755 "$srcdir/target/release/spacemapper" "$pkgdir/usr/bin/spacemapper"
  install -Dm644 packaging/spacemapper.desktop "$pkgdir/usr/share/applications/spacemapper.desktop"
  for size in 32 48 64 128 256 512; do
    install -Dm644 "assets/icon/spacemapper-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/spacemapper.png"
  done
  install -Dm644 packaging/io.github.martin_ii.spacemapper.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.martin_ii.spacemapper.metainfo.xml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/spacemapper/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/spacemapper/LICENSE"
  install -Dm644 assets/Inter-LICENSE.txt "$pkgdir/usr/share/licenses/spacemapper/Inter-LICENSE.txt"
}
